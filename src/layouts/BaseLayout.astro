---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A cozy corner of the internet for learning and coding.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="algolia-site-verification" content="3CD32047C73D79B9" />
    <meta name="google-site-verification" content="google7cc6dda0a5d6bdfc" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="logo">pg of code<span class="cursor">_</span></a>
        <div class="nav-right">
          <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <span class="menu-icon"></span>
          </button>
          <div class="nav-links" id="nav-links">
            <a href="/til" class:list={[{ active: currentPath.startsWith('/til') }]}>~/til</a>
            <a href="/coding-notes" class:list={[{ active: currentPath.startsWith('/coding-notes') }]}>~/coding-notes</a>
            <a href="/thoughts" class:list={[{ active: currentPath.startsWith('/thoughts') }]}>~/thoughts</a>
            <a href="/experiments" class:list={[{ active: currentPath.startsWith('/experiments') }]}>~/experiments</a>
            <a href="/ai-taught-me" class:list={[{ active: currentPath.startsWith('/ai-taught-me') }]}>~/ai-taught-me</a>
          </div>
          <div class="nav-actions">
            <div id="docsearch" class="nav-search"></div>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
              <span class="icon-sun">&#9788;</span>
              <span class="icon-moon">&#9790;</span>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="main fade-in">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-copy">
          <p class="footer-line">can't wait to live in the cloud<span class="footer-cursor">_</span></p>
          <a href="https://x.com/pgofcode" target="_blank" rel="noopener noreferrer" class="social-link">𝕏 @pgofcode</a>
        </div>
        <div class="footer-links">
          <a href="#" class="back-to-top" aria-label="Back to top">&uarr; top</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const theme = saved || 'dark';
        document.documentElement.setAttribute('data-theme', theme);

        document.addEventListener('DOMContentLoaded', function() {
          var btn = document.getElementById('theme-toggle');
          if (btn) {
            btn.addEventListener('click', function() {
              var current = document.documentElement.getAttribute('data-theme');
              var next = current === 'dark' ? 'light' : 'dark';
              document.documentElement.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
            });
          }

          var menuBtn = document.getElementById('menu-toggle');
          var navLinks = document.getElementById('nav-links');
          if (menuBtn && navLinks) {
            menuBtn.addEventListener('click', function() {
              var open = navLinks.classList.toggle('open');
              menuBtn.setAttribute('aria-expanded', open);
              menuBtn.classList.toggle('is-open', open);
            });
          }
        });
      })();
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@docsearch/js@3"></script>
    <script is:inline>
      docsearch({
        container: '#docsearch',
        appId: '2ANCFEON0C',
        indexName: 'pgofcode crawler',
        apiKey: '5d9e624dcd736c7342d6683fc649864e',
      });
    </script>
  </body>
</html>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(14px);
    background: var(--nav-bg);
  }

  .nav-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0.95rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .logo {
    font-family: 'Fira Code', monospace;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .logo:hover {
    color: var(--link-hover);
  }

  .logo .cursor {
    animation: blink 1s step-end infinite;
    color: var(--text-light);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .nav-links {
    display: flex;
    gap: 1rem;
    position: relative;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 28px;
    height: 28px;
    position: relative;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-light);
    border-radius: 1px;
    transition: all 0.25s ease;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .menu-icon {
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .menu-icon::before {
    content: '';
    top: -6px;
  }

  .menu-icon::after {
    content: '';
    top: 6px;
  }

  .menu-toggle.is-open .menu-icon {
    background: transparent;
  }

  .menu-toggle.is-open .menu-icon::before {
    top: 0;
    transform: translateX(-50%) rotate(45deg);
  }

  .menu-toggle.is-open .menu-icon::after {
    top: 0;
    transform: translateX(-50%) rotate(-45deg);
  }

  .theme-toggle {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--text-light);
    transition: color 0.2s;
    height: 24px;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle:hover {
    color: var(--link-hover);
  }

  :global([data-theme="dark"]) .icon-sun { display: inline; }
  :global([data-theme="dark"]) .icon-moon { display: none; }
  :global([data-theme="light"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: inline; }
  :global(:not([data-theme])) .icon-sun { display: inline; }
  :global(:not([data-theme])) .icon-moon { display: none; }

  .nav-links a {
    font-size: 0.82rem;
    font-family: 'Fira Code', monospace;
    font-weight: 500;
    color: var(--text-light);
    padding: 0;
    border-bottom: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--link-hover);
  }

  .main {
    max-width: 1040px;
    margin: 0 auto;
    padding: 4.25rem 1.5rem 5rem;
    min-height: calc(100vh - 160px);
    position: relative;
  }

  .footer {
    padding: 2rem 1.5rem 3rem;
    color: var(--text-light);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    max-width: 1040px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-line {
    font-size: 0.82rem;
    color: var(--text-light);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-to-top {
    font-size: 0.75rem;
    font-family: 'Fira Code', monospace;
    color: var(--text-light);
    transition: color 0.2s;
  }

  .back-to-top:hover {
    color: var(--link-hover);
  }

  .social-link {
    font-size: 0.8rem;
    color: var(--text-light);
    transition: color 0.2s;
  }

  .social-link:hover {
    color: var(--link-hover);
  }

  .footer-cursor {
    animation: blink 1s step-end infinite;
  }

  @media (max-width: 640px) {
    .menu-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--nav-bg);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0.85rem 1rem 1rem;
      gap: 0.5rem;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 0.35rem 0;
    }

    .nav-right {
      gap: 0.75rem;
    }

    .nav-search {
      display: none;
    }

    :global(.DocSearch-Button-Keys) {
      display: none !important;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .footer-links {
      justify-content: flex-start;
    }

    .footer-nav {
      justify-content: flex-start;
      gap: 0.9rem;
    }
  }

  @media (max-width: 900px) {
    .nav-inner {
      padding-inline: 1rem;
    }

    .nav-actions {
      margin-left: 0;
    }

    :global(.DocSearch-Button-Placeholder) {
      display: none;
    }
  }

  /* DocSearch overrides to match theme */
  :global(.DocSearch-Button) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 0.75rem;
    cursor: pointer;
    color: var(--text-light);
    height: 38px;
    margin: 0;
    gap: 0.45rem;
    transition: all 0.2s;
  }

  :global(.DocSearch-Button:hover) {
    border-color: var(--text-heading);
    color: var(--text-heading);
    background: none;
    box-shadow: none;
  }

  :global(.DocSearch-Button .DocSearch-Search-Icon) {
    width: 14px;
    height: 14px;
    color: inherit;
  }

  :global(.DocSearch-Button-Placeholder) {
    display: inline;
    font-size: 0.78rem;
    font-family: 'Fira Code', monospace;
  }

  :global(.DocSearch-Button-Keys) {
    display: flex;
    gap: 2px;
    min-width: auto;
    padding: 0;
  }

  :global(.DocSearch-Button-Key) {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 3px;
    box-shadow: none;
    color: var(--text-light);
    font-family: 'Fira Code', monospace;
    font-size: 0.65rem;
    padding: 0 0.25rem;
    min-width: 0;
    width: auto;
    height: auto;
    line-height: 1.4;
    top: 0;
  }
</style>
