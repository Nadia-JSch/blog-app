---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
    image?: string;
    section?: string;
  };
  headings?: Heading[];
}

const { frontmatter, headings = [] } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pathname = Astro.url.pathname;
const section = pathname.split('/').filter(Boolean)[0] || '';
const sectionLabels: Record<string, string> = {
  'til': 'Today I Learned',
  'coding-notes': 'Coding Notes',
  'thoughts': 'Thoughts',
  'experiments': 'Experiments',
};
const sectionLabel = sectionLabels[section] || '';
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="post-shell">
    <div class="post-main">
      {sectionLabel && (
        <nav class="breadcrumb">
          <a href={`/${section}`}>~/{section}</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">{frontmatter.title}</span>
        </nav>
      )}
      <header class="post-header">
        {frontmatter.image && (
          <img src={frontmatter.image} alt="" class="hero-image" />
        )}
        {sectionLabel && <p class="post-kicker">{sectionLabel}</p>}
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="post-dek">{frontmatter.description}</p>}
        <div class="post-meta">
          <time datetime={frontmatter.date}>{formattedDate}</time>
          {frontmatter.tags && (
            <div class="tags">
              {frontmatter.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>
      </header>
      {headings.length > 0 && (
        <div class="toc-inline">
          <TableOfContents headings={headings} />
        </div>
      )}
      <article class="post-body">
        <div class="post-content">
          <slot />
        </div>
        <hr />
        <footer class="post-footer">
          {sectionLabel && (
            <a href={`/${section}`} class="footer-back">&larr; Back to {sectionLabel}</a>
          )}
        </footer>
      </article>
    </div>

    {headings.length > 0 && (
      <aside class="toc-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>

<style is:global>
  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .toc-sidebar {
      display: block;
    }
  }
</style>

<style>
  .post-shell {
    display: block;
  }

  .post-main {
    min-width: 0;
    max-width: 760px;
  }

  @media (min-width: 1280px) {
    .post-shell {
      display: grid;
      grid-template-columns: minmax(0, 880px) 190px;
      justify-content: center;
      gap: 7rem;
      align-items: start;
    }

    .toc-sidebar {
      position: sticky;
      top: 10rem;
      max-height: calc(100vh - 6.5rem);
      overflow: auto;
      justify-self: end;
      width: 190px;
    }
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--text-light);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--text-heading);
  }

  .breadcrumb-sep {
    color: var(--text-light);
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--text-light);
    opacity: 0.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-footer {
    padding-top: 0.5rem;
  }

  .footer-back {
    font-size: 0.85rem;
    color: var(--text-light);
    transition: color 0.2s;
  }

  .footer-back:hover {
    color: var(--text-heading);
  }

  .hero-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.4rem;
    border: 1px solid var(--border);
    box-shadow: none;
  }

  .post-header {
    border-bottom: 1px solid rgba(224, 176, 96, 0.12);
    padding: 0 0 1.35rem;
    background: none;
    box-shadow: none;
    margin-bottom: 2.25rem;
    max-width: 74ch;
  }

  .post-body {
    padding: 0;
  }

  .toc-inline {
    margin-bottom: 2rem;
  }

  @media (min-width: 1280px) {
    .toc-inline {
      display: none;
    }
  }

  :global([data-theme="light"]) .post-header {
    border-color: rgba(148, 104, 32, 0.14);
  }

  .post-kicker {
    font-family: 'Fira Code', monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-light);
    margin-bottom: 0.8rem;
  }

  .post-header h1 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    color: var(--text-heading);
    margin-bottom: 0.7rem;
    letter-spacing: -0.05em;
    max-width: 18ch;
    line-height: 1.05;
  }

  .post-dek {
    max-width: 58ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text);
    margin-bottom: 0.9rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    font-size: 0.8rem;
    font-family: 'Fira Code', monospace;
    color: var(--text-light);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid transparent;
  }

  .tag:hover {
    background: var(--tag-bg-hover);
    color: var(--tag-text-hover);
    border-color: var(--tag-text-hover);
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.9;
    max-width: 78ch;
    color: var(--text);
  }

  .post-content :global(h1) {
    font-size: 1.75rem;
    color: var(--text-heading);
    margin: 3rem 0 0.85rem;
    letter-spacing: -0.03em;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    color: var(--text-heading);
    margin: 2.8rem 0 0.9rem;
    letter-spacing: -0.02em;
  }

  .post-content :global(h3) {
    font-size: 1.22rem;
    color: var(--text-heading);
    margin: 2rem 0 0.6rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.55rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.4rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.45rem;
  }

  .post-content :global(pre) {
    margin-block: 2rem;
  }

  .post-content :global(img) {
    margin: 2rem 0;
    border: 1px solid var(--border);
    box-shadow: none;
  }

  .post-content :global(blockquote) {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .post-header {
      padding: 0 0 1rem;
      margin-bottom: 1.75rem;
    }

    .post-header h1 {
      max-width: none;
    }

    .hero-image {
      height: 220px;
    }
  }
</style>
