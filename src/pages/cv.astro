---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  { label: 'Email', text: 'jasminesch@gmail.com', href: 'mailto:jasminesch@gmail.com' },
  { label: 'GitHub', text: 'GitHub', href: 'https://github.com/Nadia-JSch/' },
  { label: 'LinkedIn', text: 'LinkedIn', href: 'https://www.linkedin.com/in/nadiaschmidtkeza/' },
  { label: 'X', text: '@pgofcode', href: 'https://x.com/pgofcode' },
];

const skills = [
  'Terminal use',
  'Agentic AI',
  'HTML & CSS',
  'JavaScript',
  'MySQL',
  'Git & GitHub',
  'Markdown',
  'Jira',
];

const competencies = [
  'Explaining complex technical concepts simply',
  'Collaborating remotely and async',
  'Adaptability',
  'Self-study',
  'Problem-solving',
];

const experience = [
  {
    role: 'Technical Writer',
    org: 'Ritza',
    dates: 'May 2023 - present',
    points: [
      'Creating and maintaining technical content for different clients in IT and frontend development.',
      'Using the docs-as-code workflow and WordPress.',
      'Using AI-assisted workflows for content creation, cleanup, and admin.',
      'Creating social media posts about a JavaScript component library.',
      'Managing the publication cycle of blog posts (draft to approval).',
      'Communicating with clients and SMEs.',
      'Updating and creating landing pages for product features and integrations.',
      'Supporting project coordination across client deliverables.',
    ],
  },
  {
    role: 'Junior Software Developer (part-time)',
    org: 'Rubigo IT',
    dates: 'Nov 2022 - Apr 2023',
    points: [
      "Making design changes to a client's website.",
      'Working with Laravel and Vue.js.',
    ],
  },
  {
    role: 'English as a 2nd Language Teacher',
    org: 'The Really Great Teacher Company',
    dates: 'Aug 2020 - Aug 2021',
    points: [
      'Preparing and delivering online English lessons.',
      "Assessing students' ability and progress.",
    ],
  },
  {
    role: 'Freelance Content Writer',
    org: 'Freelance',
    dates: '2016 - 2021',
    points: [
      'Writing articles about well-being for various online publications.',
      'Ghostwriting about personal finance.',
    ],
  },
  {
    role: 'Departmental Academic Tutor',
    org: 'Rhodes University',
    dates: 'Mar 2013 - Jun 2015',
    points: [
      'Facilitating and preparing weekly tutorials and practical demonstrations. Marking student assignments.',
      'Giving student-focused feedback and explanations.',
    ],
  },
];

const education = [
  { title: 'MSc. Human Kinetics and Ergonomics', sub: 'Rhodes University', year: '2020' },
  { title: 'BA. (Philosophy, Human Kinetics & Ergonomics)', sub: 'Rhodes University', year: '2014' },
];

const courses = [
  { title: 'freeCodeCamp', sub: 'JavaScript Certification', year: '2025 - present' },
  { title: 'Software Engineering Bootcamp', sub: 'HyperionDev', year: '2022', link: { label: 'Portfolio', href: '#' } },
  { title: 'Introduction to SQL for Data Science', sub: 'Coursera · University of California', year: '2021' },
  { title: 'Introduction to Programming in Python', sub: 'Coursera · Rice University', year: '2016' },
];
---

<BaseLayout title="Nadia-Jasmine Schmidtke - CV" description="Curriculum vitae of Nadia-Jasmine Schmidtke, technical writer.">
  <article class="cv">
    <header class="cv-header">
      <h1 class="cv-name">Nadia-Jasmine Schmidtke</h1>
      <p class="cv-title">Technical writer</p>
      <div class="cv-header-cols">
        <ul class="cv-contacts">
          {contacts.map((c) => (
            <li>
              <span class="cv-contact-label">{c.label}</span>
              <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer">{c.text}</a>
            </li>
          ))}
        </ul>
        <p class="cv-summary">
          Technical writer with an academic background and teaching experience. Skilled in
          documentation, social media content, and AI-assisted workflows. Looking to grow within a
          collaborative, documentation-focused team.
        </p>
      </div>
    </header>

    <section class="cv-section">
      <h2>Experience</h2>
      <div class="cv-jobs">
        {experience.map((job) => (
          <div class="cv-job">
            <div class="cv-job-head">
              <h3>{job.role}</h3>
              <span class="cv-job-meta"><span class="cv-org">{job.org}</span> · {job.dates}</span>
            </div>
            <ul class="cv-bullets">
              {job.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="cv-section">
      <h2>Skills</h2>
      <div class="cv-skill-group">
        <span class="cv-skill-label">Technical</span>
        <ul class="cv-chips">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="cv-skill-group">
        <span class="cv-skill-label">Strengths</span>
        <ul class="cv-chips cv-chips-soft">
          {competencies.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section class="cv-section">
      <div class="cv-two-up">
        <div>
          <h2>Education</h2>
          <ul class="cv-list-entries">
            {education.map((e) => (
              <li>
                <span class="cv-entry-title">{e.title}</span>
                <span class="cv-entry-sub">{e.sub} <span class="cv-year">{e.year}</span></span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Courses &amp; certifications</h2>
          <ul class="cv-list-entries">
            {courses.map((c) => (
              <li>
                <span class="cv-entry-title">{c.title}</span>
                <span class="cv-entry-sub">
                  {c.sub} <span class="cv-year">{c.year}</span>
                  {c.link && <> · <a href={c.link.href}>{c.link.label}</a></>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section cv-references">
      <h2>References</h2>
      <p class="cv-sub">Available on request.</p>
    </section>
  </article>
</BaseLayout>

<style>
  .cv {
    max-width: 820px;
    margin: 0 auto;
  }

  /* ---- Header ---- */
  .cv-header {
    margin-bottom: 4rem;
  }

  .cv-name {
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    color: var(--text-heading);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .cv-title {
    font-family: 'Fira Code', monospace;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .cv-header-cols {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3rem;
    align-items: start;
  }

  .cv-contacts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .cv-contacts li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.92rem;
  }

  .cv-contact-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
  }

  .cv-summary {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
    max-width: 50ch;
  }

  /* ---- Sections ---- */
  .cv-section {
    margin-bottom: 4rem;
  }

  .cv-section:last-child {
    margin-bottom: 0;
  }

  .cv-section > h2,
  .cv-two-up h2 {
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-heading);
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  /* ---- Experience ---- */
  .cv-jobs {
    display: grid;
    gap: 2.25rem;
  }

  .cv-job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.25rem 1rem;
    margin-bottom: 0.6rem;
  }

  .cv-job-head h3 {
    font-size: 1.08rem;
    color: var(--text);
    line-height: 1.3;
  }

  .cv-job-meta {
    font-size: 0.88rem;
    color: var(--text-light);
    font-family: 'Fira Code', monospace;
  }

  .cv-org {
    color: color-mix(in srgb, var(--text-light) 60%, var(--text) 40%);
  }

  .cv-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .cv-bullets li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
  }

  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background: var(--text-heading);
    border-radius: 1px;
  }

  /* ---- Skills chips ---- */
  .cv-skill-group {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: start;
    gap: 0.5rem 1rem;
    margin-bottom: 1.1rem;
  }

  .cv-skill-group:last-child {
    margin-bottom: 0;
  }

  .cv-skill-label {
    font-family: 'Fira Code', monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-heading);
    padding-top: 0.4rem;
  }

  .cv-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cv-chips li {
    background: var(--tag-bg);
    color: var(--tag-text);
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    line-height: 1.3;
  }

  .cv-chips-soft li {
    background: var(--bg-soft);
    color: var(--text-light);
    border: 1px solid var(--border);
  }

  /* ---- Education / Courses two-up ---- */
  .cv-two-up {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .cv-list-entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .cv-list-entries li {
    display: grid;
    gap: 0.15rem;
  }

  .cv-entry-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }

  .cv-entry-sub {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.45;
  }

  .cv-year {
    font-family: 'Fira Code', monospace;
    font-size: 0.78rem;
  }

  /* ---- References ---- */
  .cv-references .cv-sub {
    font-size: 0.95rem;
    color: var(--text-light);
  }

  @media (max-width: 640px) {
    .cv-header-cols,
    .cv-two-up {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .cv-skill-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .cv-skill-label {
      padding-top: 0;
    }

    .cv-job-head {
      flex-direction: column;
    }
  }
</style>
