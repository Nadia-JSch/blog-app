---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import ExperimentPlayground from '../../components/ExperimentPlayground.astro';

export async function getStaticPaths() {
  const posts = await getCollection('experiments', (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout frontmatter={post.data} headings={headings}>
  <ExperimentPlayground demo={post.data.demo} />
  <Content />
</PostLayout>
