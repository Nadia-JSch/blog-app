---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const collections = await Promise.all([
  getCollection('til', (p) => !p.data.draft),
  getCollection('coding-notes', (p) => !p.data.draft),
  getCollection('thoughts', (p) => !p.data.draft),
  getCollection('ai-taught-me', (p) => !p.data.draft),
  getCollection('experiments', (p) => !p.data.draft),
]);

const latestPosts = collections
  .flatMap((posts, index) => {
    const section = ['til', 'coding-notes', 'thoughts', 'ai-taught-me', 'experiments'][index];
    return posts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      date: post.data.date,
      href: `/${section}/${post.id}`,
      section,
    }));
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 1);

const sectionLabels: Record<string, string> = {
  'til': 'Today I Learned',
  'coding-notes': 'Coding Notes',
  'thoughts': 'Thoughts',
  'ai-taught-me': 'AI Taught Me',
  'experiments': 'Experiments',
};
---

<BaseLayout title="pg of code - Home">
  <section class="hero-shell">
    <div class="hero">
      <p class="eyebrow">pg of code</p>
      <h1>Coding notes, essays, and experiments</h1>
      <p class="hero-line">A personal blog by Nadia about learning in public, building projects, and keeping useful notes.</p>
      <div class="hero-actions">
        <a href="/coding-notes" class="hero-link hero-link-primary">Read the notes</a>
        <a href="/thoughts" class="hero-link">Browse essays</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Site sections">
      <p class="panel-kicker">Start here</p>
      <div class="hero-links">
        <a href="/til" class="hero-panel-link">
          <strong>~/til</strong>
          <span>Quick lessons and notes I want to remember.</span>
        </a>
        <a href="/coding-notes" class="hero-panel-link">
          <strong>~/coding-notes</strong>
          <span>Notes on frontend fundamentals and more.</span>
        </a>
        <a href="/thoughts" class="hero-panel-link">
          <strong>~/thoughts</strong>
          <span>Writing on learning, AI, and building things.</span>
        </a>
      </div>
    </aside>
  </section>

  <section class="writing-list" aria-labelledby="latest-writing">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Latest writing</p>
        <h2 id="latest-writing">Lately, I’ve been writing about</h2>
      </div>
      <a href="/coding-notes" class="section-link">See all notes</a>
    </div>

    <ol class="home-posts">
      {latestPosts.map((post) => (
        <li class="home-post">
          <p class="home-post-meta">
            <span>{sectionLabels[post.section]}</span>
            <time datetime={post.date}>
              {new Date(post.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
          </p>
          <h3>
            <a href={post.href}>{post.title}</a>
          </h3>
          {post.description && <p class="home-post-summary">{post.description}</p>}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.8fr);
    gap: 0;
    align-items: stretch;
    margin-bottom: 3rem;
  }

  .hero {
    position: relative;
    padding: 2rem 2rem 2rem 0;
    border-bottom: 1px solid var(--border);
    background: none;
    overflow: hidden;
  }

  .hero-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 14% 18%, rgba(255, 248, 236, 0.4) 0 1px, transparent 2px),
      radial-gradient(circle at 70% 22%, rgba(255, 248, 236, 0.36) 0 1px, transparent 2px),
      radial-gradient(circle at 84% 40%, rgba(255, 248, 236, 0.32) 0 1px, transparent 2px),
      radial-gradient(circle at 42% 72%, rgba(255, 248, 236, 0.3) 0 1px, transparent 2px);
    opacity: 0.42;
    pointer-events: none;
  }

  .hero::after {
    content: none;
  }

  .hero h1 {
    font-size: clamp(3.2rem, 8vw, 5.2rem);
    color: var(--text-heading);
    margin-bottom: 0.85rem;
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 10ch;
  }

  .hero-line {
    font-size: 1.08rem;
    color: var(--text);
    max-width: 34ch;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0;
    border-radius: 0;
    border: none;
    background: transparent;
    color: var(--text-light);
    font-family: 'Fira Code', monospace;
    font-size: 0.82rem;
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .hero-link:hover {
    transform: none;
    color: var(--link-hover);
    background: transparent;
  }

  .hero-link-primary {
    color: var(--text-heading);
  }

  .hero-panel {
    position: relative;
    padding: 2rem 0 2rem 2rem;
    border-left: 1px solid var(--border);
    background: none;
    min-height: 100%;
  }

  .panel-kicker,
  .section-kicker {
    font-family: 'Fira Code', monospace;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-light);
    margin-bottom: 0.8rem;
  }

  .hero-panel h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.04em;
    max-width: 16ch;
    margin-bottom: 0.9rem;
  }

  .hero-panel p:last-child {
    max-width: 34ch;
    color: var(--text-light);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .hero-links {
    display: grid;
    gap: 0.8rem;
  }

  .hero-panel-link {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid rgba(239, 187, 103, 0.08);
    background: transparent;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .hero-panel-link:hover {
    transform: none;
    border-color: var(--border-hover);
    background: transparent;
    color: var(--text);
  }

  .hero-panel-link:visited,
  .hero-panel-link:active {
    color: var(--text);
  }

  .hero-panel-link strong {
    font-family: 'Fira Code', monospace;
    font-size: 0.84rem;
    color: var(--text-heading);
  }

  .hero-panel-link span {
    color: var(--text-light);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .writing-list h2 {
    font-size: 1.55rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .section-link {
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: var(--text-light);
  }

  .home-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-post {
    padding: 1rem 0 1.2rem;
    border-bottom: 1px solid var(--border);
    background: transparent;
    transition: border-color 0.2s ease;
  }

  .home-post:first-child {
    grid-column: 1 / -1;
    padding: 0 0 1.35rem;
    border-bottom: none;
  }

  .home-post:first-child h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    max-width: 24ch;
  }

  .home-post:first-child .home-post-summary {
    font-size: 1rem;
    max-width: 62ch;
  }

  .home-post:hover {
    border-color: var(--border-hover);
  }

  .home-post-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.32rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--text-light) 78%, var(--text) 22%);
  }

  .home-post h3 {
    margin: 0 0 0.42rem;
    font-size: 1.18rem;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .home-post h3 a {
    color: color-mix(in srgb, var(--text) 82%, var(--text-light) 18%);
    transition: color 0.2s;
  }

  .home-post h3 a:hover {
    color: var(--link-hover);
  }

  .home-post-summary {
    max-width: 50ch;
    font-size: 0.95rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--text-light) 84%, var(--text) 16%);
  }

  @media (max-width: 900px) {
    .hero-shell,
    .home-posts {
      grid-template-columns: 1fr;
    }

    .hero-panel h2 {
      max-width: none;
    }

    .home-post:first-child {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .hero h1 {
      max-width: none;
      font-size: 2.2rem;
    }

    .hero {
      padding: 1.5rem 0 1.5rem;
    }

    .hero-panel,
    .home-post {
      padding-left: 0;
      padding-right: 0;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .hero-panel {
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 1.2rem;
    }
  }
</style>
