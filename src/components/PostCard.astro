---
interface Props {
  title: string;
  date: string;
  description?: string;
  url: string;
  tags?: string[];
}

const { title, date, description, url, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={url} class="card">
  <div class="card-meta">
    <div class="card-row-1-right">
      {tags && (
        <div class="card-tags">
          {tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <time datetime={date}>{formattedDate}</time>
    </div>
    <span class="card-arrow" aria-hidden="true">&rarr;</span>
  </div>
  <div class="card-row-1">
    <h3>{title}</h3>
  </div>
  {description && <p class="card-row-2">{description}</p>}
</a>

<style>
  .card {
    display: block;
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0 1rem;
    transition: color 0.2s, border-color 0.2s;
    color: inherit;
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--border-hover);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }

  .card-row-1 {
    margin-bottom: 0.35rem;
  }

  .card-row-1 h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .card-row-1-right {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.68rem;
    color: var(--tag-text);
    opacity: 0.85;
  }

  .tag::before {
    content: '#';
  }

  .card-row-1-right time {
    font-size: 0.74rem;
    font-family: 'Fira Code', monospace;
    color: var(--text-light);
    white-space: nowrap;
  }

  .card-arrow {
    color: var(--text-light);
    transition: transform 0.2s, color 0.2s;
    opacity: 0.75;
  }

  .card:hover .card-arrow {
    color: var(--text-heading);
    transform: translateX(2px);
  }

  .card-row-2 {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 640px) {
    .card {
      padding: 0.85rem 0 0.95rem;
    }

    .card-meta {
      align-items: flex-start;
    }

    .card-row-1 h3 {
      font-size: 1.05rem;
    }

  }
</style>
