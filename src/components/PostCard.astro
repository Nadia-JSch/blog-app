---
interface Props {
  title: string;
  date: string;
  description?: string;
  url: string;
  tags?: string[];
}

const { title, date, description, url, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="entry">
  <div class="entry-meta">
    <time datetime={date}>{formattedDate}</time>
    {tags && tags.length > 0 && (
      <p class="entry-tags">
        {tags.map((tag: string, index: number) => (
          <>
            <span class="tag">{tag.replace(/^#/, '')}</span>
            {index < tags.length - 1 && <span class="tag-sep">·</span>}
          </>
        ))}
      </p>
    )}
  </div>
  <h3>
    <a href={url} class="entry-link">{title}</a>
  </h3>
  {description && <p class="entry-summary">{description}</p>}
</article>

<style>
  .entry {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0 1.15rem;
  }

  .entry-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .entry h3 {
    font-size: 1.22rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.32rem;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .entry-link {
    color: var(--text);
    transition: color 0.2s;
  }

  .entry-link:hover {
    color: var(--link-hover);
  }

  .entry-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    color: var(--text-light);
    font-size: 0.72rem;
    font-family: 'Fira Code', monospace;
  }

  .tag {
    white-space: nowrap;
  }

  .tag::before {
    content: '#';
  }

  .tag-sep {
    opacity: 0.5;
  }

  .entry-meta time {
    font-size: 0.74rem;
    font-family: 'Fira Code', monospace;
    color: var(--text-light);
    white-space: nowrap;
  }

  .entry-summary {
    font-size: 0.94rem;
    color: var(--text-light);
    line-height: 1.65;
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .entry {
      padding: 0.9rem 0 1rem;
    }

    .entry h3 {
      font-size: 1.08rem;
    }
  }
</style>
